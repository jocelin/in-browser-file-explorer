{
	"name": "webpack-start",
	"version": "1.0.0",
	"type": "module",
	"repository": "git@github.com:gianluca-venturini/express-react-webpack-starter.git",
	"author": "Gianluca Venturini <gianluca@stellarite.io>",
	"license": "MIT",
	"scripts": {
		"build": "vite build && tsc",
		"clean": "rm -rf dist/ coverage/",
		"clean:all": "rm -rf node_modules/ dist/ coverage/",
		"dev": "concurrently \"yarn dev:backend\" \"yarn dev:frontend\"",
		"dev:frontend": "vite",
		"dev:backend": "nodemon",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"preview": "vite preview",
		"prettier": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"prettier:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"start": "node dist/backend/main.js",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"engines": {
		"yarn": "^1.10.1",
		"node": ">=10.18.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.13",
		"@types/express": "^4.17.23",
		"@types/jest": "^30.0.0",
		"@types/react": "^18.3.24",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"@vitejs/plugin-react": "^4.7.0",
		"concurrently": "^8.2.2",
		"eslint": "^8.57.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"jest": "^30.1.3",
		"nodemon": "^3.1.10",
		"prettier": "^3.6.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^4.1.13",
		"ts-jest": "^29.4.1",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2",
		"vite": "^7.1.5"
	},
	"dependencies": {
		"express": "^4.21.2"
	}
}
