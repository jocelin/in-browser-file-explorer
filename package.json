{
	"name": "webpack-start",
	"version": "1.0.0",
	"repository": "git@github.com:gianluca-venturini/express-react-webpack-starter.git",
	"author": "Gianluca Venturini <gianluca@stellarite.io>",
	"license": "MIT",
	"scripts": {
		"build": "node build.js",
		"build:frontend": "vite build",
		"clean": "rm -rf dist/",
		"clean:all": "rm -rf node_modules/ dist/",
		"dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
		"dev:frontend": "vite",
		"dev:backend": "nodemon",
		"legacy:build": "PROJECTS=frontend,backend webpack --progress",
		"legacy:build-watch": "PROJECTS=frontend,backend WATCH=true webpack --progress",
		"legacy:build-hot-reload": "node --inspect dist/server.js",
		"legacy:start": "node --inspect dist/server.js",
		"legacy:test": "PROJECTS=test webpack --progress && node --inspect ./node_modules/jasmine/bin/jasmine.js dist/test.js",
		"preview": "vite preview",
		"start": "tsx dist/backend/main.ts",
		"test": "tsx src/test.ts"
	},
	"engines": {
		"yarn": "^1.10.1",
		"node": ">=10.18.0"
	},
	"devDependencies": {
		"@types/express": "^4.17.6",
		"@types/jasmine": "^3.5.10",
		"@types/node-fetch": "^2.6.4",
		"@types/react": "^18.2.18",
		"@types/react-dom": "^18.2.7",
		"@types/webpack-env": "^1.18.1",
		"@vitejs/plugin-react": "^4.2.1",
		"concurrently": "^8.2.2",
		"html-webpack-plugin": "^5.5.3",
		"jasmine": "^3.5.0",
		"node-fetch": "^3.3.2",
		"nodemon": "^3.0.2",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"source-map-support": "^0.5.21",
		"ts-loader": "^6.2.1",
		"tsx": "^4.6.2",
		"typescript": "^5.1.6",
		"vite": "^5.0.8",
		"webpack": "^5.88.2",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^4.15.1",
		"webpack-node-externals": "^3.0.0"
	},
	"dependencies": {
		"express": "^4.17.1"
	}
}
