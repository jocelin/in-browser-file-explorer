{
	"name": "in-browser-file-explorer",
	"version": "0.0.1-demo",
	"type": "module",
	"repository": "git@github.com:jocelin/in-browser-file-explorer.git",
	"author": "Jocelyn Lin, Gianluca Venturini <gianluca@stellarite.io>",
	"license": "MIT",
	"scripts": {
		"build": "vite build && tsc",
		"clean": "rm -rf dist/ coverage/",
		"clean:all": "rm -rf node_modules/ dist/ coverage/",
		"dev": "concurrently \"yarn dev:backend\" \"yarn dev:frontend\"",
		"dev:frontend": "vite",
		"dev:backend": "nodemon",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"preview": "vite preview",
		"prettier": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"prettier:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"start": "node dist/backend/main.js",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"engines": {
		"yarn": "^1.10.1",
		"node": ">=10.18.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.36.0",
		"@tailwindcss/vite": "^4.1.13",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@types/express": "^4.17.23",
		"@types/jest": "^30.0.0",
		"@types/react": "^18.3.24",
		"@types/react-dom": "^18.3.7",
		"@types/supertest": "^6.0.3",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"@vitejs/plugin-react": "^4.7.0",
		"concurrently": "^8.2.2",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"globals": "^16.4.0",
		"jest": "^30.1.3",
		"jest-environment-jsdom": "^30.1.2",
		"nodemon": "^3.1.10",
		"prettier": "^3.6.2",
		"supertest": "^7.1.4",
		"ts-jest": "^29.4.1",
		"tsx": "^4.20.5",
		"vite": "^7.1.5"
	},
	"dependencies": {
		"express": "^4.21.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2"
	}
}
