{
	"compilerOptions": {
		"target": "ES2017",
		"module": "ES6",
		"moduleResolution": "node",
		"sourceMap": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noEmitOnError": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"removeComments": false,
		"jsx": "react",
		"outDir": "dist",
		"allowSyntheticDefaultImports": true
	},
	"include": ["src/frontend/**/*", "src/backend/main.legacy.ts", "src/test.ts"],
	"exclude": ["node_modules", "src/backend/main.ts"]
}
