{
	"compilerOptions": {
		"target": "ES6",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"sourceMap": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noEmitOnError": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"removeComments": false,
		"jsx": "react",
		"outDir": "dist",
		"rootDir": "src",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"types": ["jest", "node", "@testing-library/jest-dom"]
	},
	"include": ["src/backend/**/*"],
	"exclude": ["node_modules", "src/frontend", "src/test/setupTests.ts"]
}
