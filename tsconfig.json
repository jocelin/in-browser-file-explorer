{
	"compilerOptions": {
		"target": "ES6",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"sourceMap": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noEmitOnError": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"removeComments": false,
		"jsx": "react",
		"outDir": "dist",
		"rootDir": "src",
		"allowSyntheticDefaultImports": true,
		"types": ["jest", "node"]
	},
	"include": ["src/backend/**/*"],
	"exclude": [
		"node_modules",
		"src/frontend",
		"src/test-setup.ts",
		"**/*.spec.ts",
		"**/*.test.ts"
	]
}
