{
	"compilerOptions": {
		"target": "ES6",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"sourceMap": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noEmitOnError": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"removeComments": false,
		"jsx": "react",
		"outDir": "dist",
		"rootDir": ".",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"types": ["jest", "node", "@testing-library/jest-dom"],
		"baseUrl": "src",
		"paths": {
			"@file-explorer/*": ["frontend/*"],
			"@file-explorer/components": ["frontend/components"],
			"@file-explorer/containers": ["frontend/containers"],
			"@file-explorer/contexts": ["frontend/contexts"],
			"@file-explorer/hooks": ["frontend/hooks"],
			"@file-explorer/types": ["frontend/types"],
			"@file-explorer/test": ["../test"]
		}
	},
	"include": ["src/**/*", "test"],
	"exclude": ["node_modules"]
}
